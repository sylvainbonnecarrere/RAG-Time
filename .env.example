# ==============================================================================
# RAGTIME — Configuration des Variables d'Environnement (Souverain / On-Premise)
# ==============================================================================

# --- ENVIRONNEMENT APPLICATIF ---
RAGTIME_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=ragtime-change-me-in-production-secure-token-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- FRONTEND (Vite / React) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="RAGTIME — Beat & Pgvector"

# --- BACKEND (FastAPI / Uvicorn) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- BASE DE DONNÉES RELATIONNELLE & VECTORIELLE (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=ragtime
POSTGRES_PASSWORD=ragtime_local_db_secret_pass
POSTGRES_DB=ragtime_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ragtime:ragtime_local_db_secret_pass@localhost:5432/ragtime_db

# --- CACHE & FILES D'ATTENTE ASYNCHRONES (Redis 7 + ARQ Worker) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- RUNTIME D'INFÉRENCE LLM & EMBEDDINGS (Ollama Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_SECONDS=120

# --- OBSERVABILITÉ & TÉLÉMÉTRIE MLOPS (Prometheus / Alertmanager) ---
PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# --- SÉCURITÉ & CLOISONNEMENT TENANT ---
ENFORCE_TENANT_RLS=true
STRICT_SECURE_COOKIES=false
